generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model assigment {
  id          String       @id @default(cuid())
  title       String?
  description String?
  dueDate     DateTime?    @db.Date
  maxMarks    Int?
  expireAt    DateTime?    @db.Date
  subject_id  String
  teachers_id String
  section_id  String
  section     section      @relation(fields: [section_id], references: [id])
  subject     subject      @relation(fields: [subject_id], references: [id])
  teachers    teachers     @relation(fields: [teachers_id], references: [id])
  attachments attachment[]
  submission  submission[]
  deletedAt   DateTime?
}

model attachment {
  id            String      @id @default(cuid())
  fileurl       String?
  filetype      String?
  filename      String?
  broadcast_id  String?
  assigment_id  String?
  submission_id String?
  assigment     assigment?  @relation(fields: [assigment_id], references: [id])
  broadcast     broadcast?  @relation(fields: [broadcast_id], references: [id])
  submission    submission? @relation(fields: [submission_id], references: [id])
}

model broadcast {
  id          String       @id @default(cuid())
  title       String?      @db.VarChar
  message     String?      @db.VarChar
  targetrole  String?      @db.VarChar
  author_id   String
  attachments attachment[]
  author      users        @relation(fields: [author_id], references: [id])
}

model grade {
  id            String    @id @default(cuid())
  name          String?
  School_id     String
  School        School    @relation(fields: [School_id], references: [id])
  section       section[]
  feeStructures FeeStructure[]
  deletedAt     DateTime?
}

model principal {
  id            String    @id @default(cuid())
  qualification String?   @db.VarChar
  experinceYear Int?
  joiningDate   DateTime? @db.Date
  signatureUrl  String?   @db.VarChar
  School_id     String
  users_id      String
  users         users     @relation(fields: [users_id], references: [id])
  deletedAt     DateTime?
}

model School {
  id              String        @id @default(cuid())
  name            String?       @db.VarChar
  rankingPoint    Int?
  city            String?       @db.VarChar
  pincode         Int?
  education_board String?       @map("education board") @db.VarChar
  status          SchoolStatus   @default(ACTIVE)
  region          String?        @db.VarChar
  subscriptionRate Float         @default(80)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime?      @updatedAt
  deletedAt       DateTime?
  attendance      attendance[]
  grade           grade[]
  substitution    substitution[]
  parent          parent[]
  studioRooms     studioRooms[]
  subject         subject[]
  users           users[]
  leaveRequest    leaveRequest[]
  exams           Exam[]
  subscriptions   SchoolSubscription[]
  feeStructures   FeeStructure[]
  conversations   Conversation[]
  academicTerms   AcademicTerm[]
  schoolEvents    SchoolEvent[]
  escalations     Escalation[]
}

model section {
  id                    String                  @id @default(cuid())
  name                  String?
  grade_id              String
  classInchargeId       String?                 @unique
  assigment             assigment[]
  grade                 grade                   @relation(fields: [grade_id], references: [id])
  students              students[]
  teachersubjectsection teachersubjectsection[]
  classIncharge         teachers?               @relation("ClassIncharge", fields: [classInchargeId], references: [id])
  examSchedules         ExamSchedule[]
  deletedAt             DateTime?
}

model staff {
  id             String    @id @default(cuid())
  department     String?   @db.VarChar
  joiningDate    DateTime? @db.Date
  Experince      String?
  monthly_salary Int?      @map("monthly salary")
  licenseNumber  Int?
  assignedArea   String?   @db.VarChar
  users_id       String
  School_id      String
  users          users     @relation(fields: [users_id], references: [id])
  deletedAt      DateTime?
}

model students {
  id                  String       @id @default(cuid())
  admissionNumber     String?      @db.VarChar
  rollNumber          Int?
  dateOfBirth         DateTime?    @db.Date
  bloodGroup          String?      @db.VarChar
  fatherName          String?      @db.VarChar
  motherName          String?      @db.VarChar
  emergencyContact    String?      @db.VarChar
  rankingPoints       Int?
  users_id            String
  School_id           String
  section_id          String
  discount_percentage Int?         @default(0) @map("discount percentage")
  monthly_fee         Int?         @map("monthly fee")
  status              EnrollmentStatus @default(ACTIVE)
  enrolledAt          DateTime         @default(now())
  transferredAt       DateTime?
  parent              parent[]
  section             section      @relation(fields: [section_id], references: [id])
  users               users        @relation(fields: [users_id], references: [id])
  submission          submission[]
  leaveRequest        leaveRequest[]
  examResults         ExamResult[]
  feeBills            StudentFeeBill[]
  deletedAt           DateTime?
}

model studioRoomBooking {
  id             String      @id @default(cuid())
  title          String?
  starttime      DateTime?   @db.Date
  endTime        DateTime?   @db.Date
  teachers_id    String
  studioRooms_id String
  School_id      String
  studioRooms    studioRooms @relation(fields: [studioRooms_id], references: [id])
  teachers       teachers    @relation(fields: [teachers_id], references: [id])
}

model studioRooms {
  id                String              @id @default(cuid())
  roomName          String?
  capacity          Int?
  description       String?
  status            Int?
  hardwareIp        Int?
  School_id         String
  studioRoomBooking studioRoomBooking[]
  timetable         timetable[]
  School            School              @relation(fields: [School_id], references: [id])
}

model subject {
  id                    String                  @id @default(cuid())
  name                  String?                 @map("name ") @db.VarChar
  type                  String?                 @db.VarChar
  code                  String?                 @db.VarChar
  School_id             String
  assigment             assigment[]
  School                School                  @relation(fields: [School_id], references: [id])
  teachersubjectsection teachersubjectsection[]
  examSchedules         ExamSchedule[]
  deletedAt             DateTime?
}

model submission {
  id            String       @id @default(cuid())
  content       String?
  fileUrl       String?
  status        String?
  obatinedmarks Int?
  submittedAt   DateTime?    @db.Date
  assigment_id  String
  students_id   String
  assigment     assigment    @relation(fields: [assigment_id], references: [id])
  students      students     @relation(fields: [students_id], references: [id])
  attachments   attachment[]
  deletedAt     DateTime?
}

model teachers {
  id                    String                  @id @default(cuid())
  qualification         String?                 @db.VarChar
  specilization         String?                 @db.VarChar
  joiningDate           DateTime?               @db.Date
  Experince             String?
  monthlySalary         Int?
  users_id              String
  School_id             String
  assigment             assigment[]
  inchargeOf            section?                @relation("ClassIncharge")
  studioRoomBooking     studioRoomBooking[]
  users                 users                   @relation(fields: [users_id], references: [id])
  teachersubjectsection teachersubjectsection[]
  originalSubstitutions substitution[]         @relation("OriginalTeacher")
  assignedSubstitutions substitution[]         @relation("SubTeacher")
  sentSwapRequests      StudioRoomSwapRequest[] @relation("FromTeacher")
  receivedSwapRequests  StudioRoomSwapRequest[] @relation("ToTeacher")
}

model teachersubjectsection {
  id          String      @id @default(cuid())
  teachers_id String
  subject_id  String
  section_id  String
  section     section     @relation(fields: [section_id], references: [id])
  subject     subject     @relation(fields: [subject_id], references: [id])
  teachers    teachers    @relation(fields: [teachers_id], references: [id])
  timetable   timetable[]
}

model timetable {
  id                        String                @id @default(cuid())
  dayOfWeek                 String
  lectureNo                 Int
  startTime                 String?
  endTime                   String?
  teachersubjectsection_id  String
  studioRoomId              String?
  teachersubjectsection     teachersubjectsection @relation(fields: [teachersubjectsection_id], references: [id])
  studioRoom                studioRooms?          @relation(fields: [studioRoomId], references: [id])
  substitution              substitution[]
  sentSwapRequests          StudioRoomSwapRequest[] @relation("FromSwap")
  receivedSwapRequests      StudioRoomSwapRequest[] @relation("ToSwap")

  @@unique([dayOfWeek, lectureNo, teachersubjectsection_id])
}

model StudioRoomSwapRequest {
  id              String      @id @default(cuid())
  fromTimetableId String
  toTimetableId   String?     
  fromTeacherId   String
  toTeacherId     String
  status          RequestStatus @default(PENDING)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  fromTimetable   timetable   @relation("FromSwap", fields: [fromTimetableId], references: [id])
  toTimetable     timetable?  @relation("ToSwap", fields: [toTimetableId], references: [id])
  fromTeacher     teachers    @relation("FromTeacher", fields: [fromTeacherId], references: [id])
  toTeacher       teachers    @relation("ToTeacher", fields: [toTeacherId], references: [id])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model substitution {
  id                String      @id @default(cuid())
  date              DateTime    @db.Date
  timetable_id      String
  originalTeacherId String
  subTeacherId      String
  role              String?     @db.VarChar // e.g., 'TEACHING', 'DISCIPLINE', 'REVISION'
  message           String?     @db.VarChar
  School_id         String

  timetable       timetable @relation(fields: [timetable_id], references: [id])
  originalTeacher teachers  @relation("OriginalTeacher", fields: [originalTeacherId], references: [id])
  subTeacher      teachers  @relation("SubTeacher", fields: [subTeacherId], references: [id])
  School          School    @relation(fields: [School_id], references: [id])

  @@unique([date, timetable_id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // e.g., "CREATE", "UPDATE", "DELETE", "LOGIN"
  module    String   // e.g., "SCHOOLS", "STUDIOS", "EXAMS"
  severity  LogSeverity @default(INFO)
  entityId  String?  // The ID of the affected record
  details   Json?    // Before/After changes or additional info
  ipAddress String?
  createdAt DateTime @default(now())

  user      users    @relation(fields: [userId], references: [id])
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

model SchoolSubscription {
  id             String             @id @default(cuid())
  invoiceId      String?
  schoolId       String
  month          String             // Format: YYYY-MM
  studentCount   Int
  ratePerStudent Float              @default(80)
  amountDue      Float
  amountPaid     Float              @default(0)
  status         SubscriptionStatus @default(PENDING)
  invoiceUrl     String?
  paidAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  school         School             @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, month])
}

model FeeStructure {
  id           String   @id @default(cuid())
  gradeId      String
  name         String   
  amount       Float
  frequency    String   
  School_id    String
  grade        grade    @relation(fields: [gradeId], references: [id])
  School       School   @relation(fields: [School_id], references: [id])

  @@unique([gradeId, name])
}

model StudentFeeBill {
  id           String             @id @default(cuid())
  studentId    String
  month        String             
  amountDue    Float
  amountPaid   Float              @default(0)
  status       SubscriptionStatus @default(PENDING) 
  dueDate      DateTime?
  paidAt       DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  student      students           @relation(fields: [studentId], references: [id])
}

model SalaryStructure {
  id           String   @id @default(cuid())
  userId       String   @unique
  baseSalary   Float
  allowances   Float    @default(0)
  deductions   Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         users    @relation(fields: [userId], references: [id])
}

model Payroll {
  id           String             @id @default(cuid())
  userId       String
  month        String             
  baseSalary   Float
  allowances   Float
  deductions   Float
  netSalary    Float
  status       SubscriptionStatus @default(PENDING)
  paidAt       DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  user         users              @relation(fields: [userId], references: [id])

  @@unique([userId, month])
}

model Conversation {
  id            String         @id @default(cuid())
  type          ConversationType @default(DIRECT)
  School_id     String?
  assignmentId  String?
  subjectId     String?
  sectionId     String?
  status        ConversationStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  
  participants  ConversationParticipant[]
  messages      Message[]
  School        School?        @relation(fields: [School_id], references: [id])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           users        @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         users        @relation(fields: [senderId], references: [id])
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum SubscriptionStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model Exam {
  id          String         @id @default(cuid())
  title       String
  term        String         
  type        ExamType       @default(INTERNAL)
  School_id   String
  School      School         @relation(fields: [School_id], references: [id])
  schedules   ExamSchedule[]
  deletedAt   DateTime?
}

model ExamSchedule {
  id          String       @id @default(cuid())
  examId      String
  subjectId   String
  sectionId   String
  date        DateTime     @db.Date
  startTime   String?
  endTime     String?
  maxMarks    Int
  passMarks   Int?
  exam        Exam         @relation(fields: [examId], references: [id])
  subject     subject      @relation(fields: [subjectId], references: [id])
  section     section      @relation(fields: [sectionId], references: [id])
  results     ExamResult[]
  deletedAt   DateTime?

  @@unique([examId, subjectId, sectionId])
}

model ExamResult {
  id             String       @id @default(cuid())
  examScheduleId String
  studentId      String
  obtainedMarks  Float
  remarks        String?
  grade          String?      
  examSchedule   ExamSchedule @relation(fields: [examScheduleId], references: [id])
  student        students     @relation(fields: [studentId], references: [id])
  deletedAt      DateTime?

  @@unique([examScheduleId, studentId])
}

enum ExamType {
  INTERNAL
  EXTERNAL
  BOARD
  COMPETITIVE
}

model AcademicTerm {
  id        String   @id @default(cuid())
  name      String   
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  status    String   @default("ACTIVE")
  School_id String
  School    School   @relation(fields: [School_id], references: [id])
  deletedAt DateTime?
}

model SchoolEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  type        EventType @default(EVENT)
  School_id   String
  deletedAt   DateTime?
  School      School    @relation(fields: [School_id], references: [id])
}

enum EventType {
  HOLIDAY
  EVENT
  EXAM_PREP
  ADMIN_ONLY
}

model parent {
  id          String   @id @default(cuid())
  users_id    String
  School_id   String
  students_id String
  School      School   @relation(fields: [School_id], references: [id])
  students    students @relation(fields: [students_id], references: [id])
  users       users    @relation(fields: [users_id], references: [id])
}

model users {
  id           String       @id @default(cuid())
  name         String?      @db.VarChar
  email        String?      @unique @db.VarChar
  password     String?      @db.VarChar
  phoneNo      String?      @db.VarChar
  fcmToken     String?      @db.VarChar
  role         UserRole     @default(STUDENT)
  School_id    String?
  photoUrl     String?      @db.VarChar
  globalRating Float        @default(0.0)
  globalRank   Int?
  attendance   attendance[]
  broadcast    broadcast[]
  parent       parent[]
  principal    principal[]
  staff        staff[]
  students     students[]
  teachers     teachers[]
  auditLogs    AuditLog[]
  leaveApproved leaveRequest[] @relation("ApprovedLeaves")
  School       School?      @relation(fields: [School_id], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime?    @updatedAt
  deletedAt    DateTime?
  salaryStructure SalaryStructure?
  payrolls     Payroll[]
  participatingConversations ConversationParticipant[]
  sentMessages Message[]
  lastActiveAt DateTime?
  AcknowledgedEscalations Escalation[] @relation("AcknowledgedEscalations")
}

model attendance {
  id        String           @id @default(cuid())
  date      DateTime         @db.Date
  status    AttendanceStatus
  users_id  String
  School_id String
  School    School           @relation(fields: [School_id], references: [id])
  users     users            @relation(fields: [users_id], references: [id])

  @@unique([users_id, date])
}

model leaveRequest {
  id            String      @id @default(cuid())
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  reason        String?
  attachmentUrl String?
  status        LeaveStatus @default(PENDING)
  studentId     String
  approvedById  String?
  School_id     String
  createdAt     DateTime    @default(now())
  
  student       students    @relation(fields: [studentId], references: [id])
  approvedBy    users?      @relation("ApprovedLeaves", fields: [approvedById], references: [id])
  School        School         @relation(fields: [School_id], references: [id])
}

model Escalation {
  id             String           @id @default(cuid())
  schoolId       String
  title          String
  description    String?
  severity       LogSeverity      @default(INFO)
  status         EscalationStatus @default(UNACKNOWLEDGED)
  reportedAt     DateTime         @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?

  school         School           @relation(fields: [schoolId], references: [id])
  acknowledgedByUser users?       @relation("AcknowledgedEscalations", fields: [acknowledgedBy], references: [id])

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

enum EscalationStatus {
  UNACKNOWLEDGED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
}

enum LeaveStatus {
  PENDING
  ESCALATED
  APPROVED
  REJECTED
}

enum LogSeverity {
  INFO
  WARN
  CRITICAL
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGEMENT
  PRINCIPAL
  TEACHER
  STUDENT
  STAFF
  PARENT
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  GRADUATED
  WITHDRAWN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HOLIDAY
}
