generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Assignment {
  id          String       @id @default(cuid())
  title       String?
  description String?
  dueDate     DateTime?    @db.Date
  maxMarks    Int?
  expireAt    DateTime?    @db.Date
  subject_id  String
  teachers_id String
  section_id  String
  deletedAt   DateTime?
  section     section      @relation(fields: [section_id], references: [id])
  subject     subject      @relation(fields: [subject_id], references: [id])
  teachers    teachers     @relation(fields: [teachers_id], references: [id])
  attachments attachment[]
  submission  submission[]

  @@map("assigment")
}

model attachment {
  id            String      @id @default(cuid())
  fileurl       String?
  filetype      String?
  filename      String?
  broadcast_id  String?
  assignment_id String?     @map("assigment_id")
  submission_id String?
  deletedAt     DateTime?
  assignment    Assignment? @relation(fields: [assignment_id], references: [id])
  broadcast     broadcast?  @relation(fields: [broadcast_id], references: [id])
  submission    submission? @relation(fields: [submission_id], references: [id])
}

model broadcast {
  id          String       @id @default(cuid())
  title       String?      @db.VarChar
  message     String?      @db.VarChar
  targetrole  String?      @db.VarChar
  author_id   String
  deletedAt   DateTime?
  attachments attachment[]
  author      users        @relation(fields: [author_id], references: [id])
}

model grade {
  id            String         @id @default(cuid())
  name          String?
  School_id     String
  deletedAt     DateTime?
  feeStructures FeeStructure[]
  School        School         @relation(fields: [School_id], references: [id])
  section       section[]
}

model principal {
  id              String    @id @default(cuid())
  qualification   String?   @db.VarChar
  experienceYears Int?      @map("experinceYear")
  joiningDate     DateTime? @db.Date
  signatureUrl    String?   @db.VarChar
  School_id       String
  users_id        String
  deletedAt       DateTime?
  users           users     @relation(fields: [users_id], references: [id])
}

model School {
  id                    String                 @id @default(cuid())
  name                  String?                @db.VarChar
  rankingPoint          Int?
  city                  String?                @db.VarChar
  pincode               Int?
  educationBoard        String?                @map("education board") @db.VarChar
  createdAt             DateTime               @default(now())
  status                SchoolStatus           @default(ACTIVE)
  updatedAt             DateTime?              @updatedAt
  deletedAt             DateTime?
  region                String?                @db.VarChar
  subscriptionRate      Float                  @default(80)
  academicTerms         AcademicTerm[]
  conversations         Conversation[]
  escalations           Escalation[]
  exams                 Exam[]
  feeStructures         FeeStructure[]
  profileChangeRequests ProfileChangeRequest[]
  schoolEvents          SchoolEvent[]
  subscriptions         SchoolSubscription[]
  attendance            attendance[]
  grade                 grade[]
  leaveRequest          leaveRequest[]
  parent                parent[]
  studioRooms           studioRooms[]
  subject               subject[]
  substitution          substitution[]
  users                 users[]
}

model section {
  id                    String                  @id @default(cuid())
  name                  String?
  grade_id              String
  classInchargeId       String?                 @unique
  deletedAt             DateTime?
  examSchedules         ExamSchedule[]
  assignments           Assignment[]
  classIncharge         teachers?               @relation("ClassIncharge", fields: [classInchargeId], references: [id])
  grade                 grade                   @relation(fields: [grade_id], references: [id])
  students              students[]
  teachersubjectsection teachersubjectsection[]
}

model staff {
  id            String    @id @default(cuid())
  department    String?   @db.VarChar
  joiningDate   DateTime? @db.Date
  experience    String?   @map("Experince")
  monthlySalary Int?      @map("monthly salary")
  licenseNumber Int?
  assignedArea  String?   @db.VarChar
  users_id      String
  School_id     String
  deletedAt     DateTime?
  users         users     @relation(fields: [users_id], references: [id])
}

model students {
  id                 String           @id @default(cuid())
  admissionNumber    String?          @db.VarChar
  rollNumber         Int?
  dateOfBirth        DateTime?        @db.Date
  bloodGroup         String?          @db.VarChar
  fatherName         String?          @db.VarChar
  motherName         String?          @db.VarChar
  emergencyContact   String?          @db.VarChar
  rankingPoints      Int?
  users_id           String
  School_id          String
  section_id         String
  discountPercentage Int?             @default(0) @map("discount percentage")
  monthlyFee         Int?             @map("monthly fee")
  enrolledAt         DateTime         @default(now())
  status             EnrollmentStatus @default(ACTIVE)
  transferredAt      DateTime?
  deletedAt          DateTime?
  examResults        ExamResult[]
  feeBills           StudentFeeBill[]
  leaveRequest       leaveRequest[]
  parent             parent[]
  section            section          @relation(fields: [section_id], references: [id])
  users              users            @relation(fields: [users_id], references: [id])
  submission         submission[]

  @@index([School_id])
  @@index([section_id])
}

model studioRoomBooking {
  id             String      @id @default(cuid())
  title          String?
  starttime      DateTime?   @db.Date
  endTime        DateTime?   @db.Date
  teachers_id    String
  studioRooms_id String
  School_id      String
  studioRooms    studioRooms @relation(fields: [studioRooms_id], references: [id])
  teachers       teachers    @relation(fields: [teachers_id], references: [id])
}

model studioRooms {
  id                String              @id @default(cuid())
  roomName          String?
  status            Int?
  hardwareIp        Int?
  School_id         String
  capacity          Int?
  description       String?
  deletedAt         DateTime?
  studioRoomBooking studioRoomBooking[]
  School            School              @relation(fields: [School_id], references: [id])
  timetable         timetable[]
}

model subject {
  id                    String                  @id @default(cuid())
  name                  String?                 @map("name ") @db.VarChar
  type                  String?                 @db.VarChar
  code                  String?                 @db.VarChar
  School_id             String
  deletedAt             DateTime?
  examSchedules         ExamSchedule[]
  assignments           Assignment[]
  School                School                  @relation(fields: [School_id], references: [id])
  teachersubjectsection teachersubjectsection[]
}

model submission {
  id            String       @id @default(cuid())
  content       String?
  fileUrl       String?
  status        String?
  submittedAt   DateTime?    @db.Date
  assignment_id String       @map("assigment_id")
  students_id   String
  obtainedMarks Int?         @map("obatinedmarks")
  deletedAt     DateTime?
  attachments   attachment[]
  assignment    Assignment   @relation(fields: [assignment_id], references: [id])
  students      students     @relation(fields: [students_id], references: [id])

  @@index([assignment_id])
  @@index([students_id])
}

model teachers {
  id                    String                  @id @default(cuid())
  qualification         String?                 @db.VarChar
  specilization         String?                 @db.VarChar
  joiningDate           DateTime?               @db.Date
  experience            String?                 @map("Experince")
  monthlySalary         Int?
  users_id              String
  School_id             String
  deletedAt             DateTime?
  sentSwapRequests      StudioRoomSwapRequest[] @relation("FromTeacher")
  receivedSwapRequests  StudioRoomSwapRequest[] @relation("ToTeacher")
  assignments           Assignment[]
  inchargeOf            section?                @relation("ClassIncharge")
  studioRoomBooking     studioRoomBooking[]
  originalSubstitutions substitution[]          @relation("OriginalTeacher")
  assignedSubstitutions substitution[]          @relation("SubTeacher")
  users                 users                   @relation(fields: [users_id], references: [id])
  teachersubjectsection teachersubjectsection[]
}

model teachersubjectsection {
  id          String      @id @default(cuid())
  teachers_id String
  subject_id  String
  section_id  String
  deletedAt   DateTime?
  section     section     @relation(fields: [section_id], references: [id])
  subject     subject     @relation(fields: [subject_id], references: [id])
  teachers    teachers    @relation(fields: [teachers_id], references: [id])
  timetable   timetable[]

  @@index([teachers_id])
  @@index([subject_id])
  @@index([section_id])
}

model timetable {
  id                       String                  @id @default(cuid())
  dayOfWeek                String
  lectureNo                Int
  startTime                String?
  endTime                  String?
  teachersubjectsection_id String
  studioRoomId             String?
  deletedAt                DateTime?
  sentSwapRequests         StudioRoomSwapRequest[] @relation("FromSwap")
  receivedSwapRequests     StudioRoomSwapRequest[] @relation("ToSwap")
  substitution             substitution[]
  studioRoom               studioRooms?            @relation(fields: [studioRoomId], references: [id])
  teachersubjectsection    teachersubjectsection   @relation(fields: [teachersubjectsection_id], references: [id])

  @@unique([dayOfWeek, lectureNo, teachersubjectsection_id])
}

model StudioRoomSwapRequest {
  id              String        @id @default(cuid())
  fromTimetableId String
  toTimetableId   String?
  fromTeacherId   String
  toTeacherId     String
  status          RequestStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  fromTeacher     teachers      @relation("FromTeacher", fields: [fromTeacherId], references: [id])
  fromTimetable   timetable     @relation("FromSwap", fields: [fromTimetableId], references: [id])
  toTeacher       teachers      @relation("ToTeacher", fields: [toTeacherId], references: [id])
  toTimetable     timetable?    @relation("ToSwap", fields: [toTimetableId], references: [id])
}

model substitution {
  id                String    @id @default(cuid())
  date              DateTime  @db.Date
  timetable_id      String
  originalTeacherId String
  subTeacherId      String
  role              String?   @db.VarChar
  message           String?   @db.VarChar
  School_id         String
  deletedAt         DateTime?
  School            School    @relation(fields: [School_id], references: [id])
  originalTeacher   teachers  @relation("OriginalTeacher", fields: [originalTeacherId], references: [id])
  subTeacher        teachers  @relation("SubTeacher", fields: [subTeacherId], references: [id])
  timetable         timetable @relation(fields: [timetable_id], references: [id])

  @@unique([date, timetable_id])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String
  action    String
  module    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime    @default(now())
  severity  LogSeverity @default(INFO)
  user      users       @relation(fields: [userId], references: [id])
}

model SchoolSubscription {
  id             String             @id @default(cuid())
  schoolId       String
  month          String
  studentCount   Int
  ratePerStudent Float              @default(80)
  amountDue      Float
  amountPaid     Float              @default(0)
  status         SubscriptionStatus @default(PENDING)
  invoiceUrl     String?
  paidAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
  invoiceId      String?
  school         School             @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, month])
}

model FeeStructure {
  id        String @id @default(cuid())
  gradeId   String
  name      String
  amount    Float
  frequency String
  School_id String
  School    School @relation(fields: [School_id], references: [id])
  grade     grade  @relation(fields: [gradeId], references: [id])

  @@unique([gradeId, name])
}

model StudentFeeBill {
  id         String             @id @default(cuid())
  studentId  String
  month      String
  amountDue  Float
  amountPaid Float              @default(0)
  status     SubscriptionStatus @default(PENDING)
  dueDate    DateTime?
  paidAt     DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?
  student    students           @relation(fields: [studentId], references: [id])
}

model SalaryStructure {
  id         String   @id @default(cuid())
  userId     String   @unique
  baseSalary Float
  allowances Float    @default(0)
  deductions Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       users    @relation(fields: [userId], references: [id])
}

model Payroll {
  id         String             @id @default(cuid())
  userId     String
  month      String
  baseSalary Float
  allowances Float
  deductions Float
  netSalary  Float
  status     SubscriptionStatus @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?
  user       users              @relation(fields: [userId], references: [id])

  @@unique([userId, month])
}

model Conversation {
  id           String                    @id @default(cuid())
  type         ConversationType          @default(DIRECT)
  School_id    String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  assignmentId String?
  sectionId    String?
  status       ConversationStatus        @default(ACTIVE)
  subjectId    String?
  deletedAt    DateTime?
  School       School?                   @relation(fields: [School_id], references: [id])
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           users        @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model ProfileChangeRequest {
  id                     String        @id @default(cuid())
  userId                 String
  School_id              String
  requestedName          String?       @db.VarChar
  requestedPhoneNo       String?       @db.VarChar
  requestedQualification String?       @db.VarChar
  requestedSpecilization String?       @db.VarChar
  status                 RequestStatus @default(PENDING)
  reviewedById           String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  School                 School        @relation(fields: [School_id], references: [id])
  reviewedBy             users?        @relation("ReviewedChangeRequests", fields: [reviewedById], references: [id])
  user                   users         @relation("UserChangeRequests", fields: [userId], references: [id])

  @@index([School_id])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         users        @relation(fields: [senderId], references: [id])
}

model Exam {
  id        String         @id @default(cuid())
  title     String
  term      String
  type      ExamType       @default(INTERNAL)
  School_id String
  deletedAt DateTime?
  School    School         @relation(fields: [School_id], references: [id])
  schedules ExamSchedule[]
}

model ExamSchedule {
  id        String       @id @default(cuid())
  examId    String
  subjectId String
  sectionId String
  date      DateTime     @db.Date
  startTime String?
  endTime   String?
  maxMarks  Int
  passMarks Int?
  deletedAt DateTime?
  results   ExamResult[]
  exam      Exam         @relation(fields: [examId], references: [id])
  section   section      @relation(fields: [sectionId], references: [id])
  subject   subject      @relation(fields: [subjectId], references: [id])

  @@unique([examId, subjectId, sectionId])
}

model ExamResult {
  id             String       @id @default(cuid())
  examScheduleId String
  studentId      String
  obtainedMarks  Float
  remarks        String?
  grade          String?
  deletedAt      DateTime?
  examSchedule   ExamSchedule @relation(fields: [examScheduleId], references: [id])
  student        students     @relation(fields: [studentId], references: [id])

  @@unique([examScheduleId, studentId])
}

model AcademicTerm {
  id        String    @id @default(cuid())
  name      String
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  status    String    @default("ACTIVE")
  School_id String
  deletedAt DateTime?
  School    School    @relation(fields: [School_id], references: [id])
}

model SchoolEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  type        EventType @default(EVENT)
  School_id   String
  deletedAt   DateTime?
  School      School    @relation(fields: [School_id], references: [id])
}

model parent {
  id          String    @id @default(cuid())
  users_id    String
  School_id   String
  students_id String
  deletedAt   DateTime?
  School      School    @relation(fields: [School_id], references: [id])
  students    students  @relation(fields: [students_id], references: [id])
  users       users     @relation(fields: [users_id], references: [id])
}

model users {
  id                         String                    @id @default(cuid())
  name                       String?                   @db.VarChar
  email                      String?                   @unique @db.VarChar
  password                   String?                   @db.VarChar
  phoneNo                    String?                   @db.VarChar
  role                       UserRole                  @default(STUDENT)
  School_id                  String?
  globalRank                 Int?
  globalRating               Float                     @default(0.0)
  photoUrl                   String?                   @db.VarChar
  deletedAt                  DateTime?
  fcmToken                   String?                   @db.VarChar
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime?                 @updatedAt
  lastActiveAt               DateTime?
  auditLogs                  AuditLog[]
  participatingConversations ConversationParticipant[]
  AcknowledgedEscalations    Escalation[]              @relation("AcknowledgedEscalations")
  sentMessages               Message[]
  payrolls                   Payroll[]
  reviewedChangeRequests     ProfileChangeRequest[]    @relation("ReviewedChangeRequests")
  profileChangeRequests      ProfileChangeRequest[]    @relation("UserChangeRequests")
  salaryStructure            SalaryStructure?
  attendance                 attendance[]
  broadcast                  broadcast[]
  leaveApproved              leaveRequest[]            @relation("ApprovedLeaves")
  parent                     parent[]
  principal                  principal[]
  staff                      staff[]
  students                   students[]
  teachers                   teachers[]
  School                     School?                   @relation(fields: [School_id], references: [id])
}

model attendance {
  id        String           @id @default(cuid())
  date      DateTime         @db.Date
  status    AttendanceStatus
  users_id  String
  School_id String
  deletedAt DateTime?
  School    School           @relation(fields: [School_id], references: [id])
  users     users            @relation(fields: [users_id], references: [id])

  @@unique([users_id, date])
  @@index([users_id])
  @@index([School_id])
}

model leaveRequest {
  id            String      @id @default(cuid())
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  reason        String?
  attachmentUrl String?
  status        LeaveStatus @default(PENDING)
  studentId     String
  approvedById  String?
  School_id     String
  createdAt     DateTime    @default(now())
  deletedAt     DateTime?
  School        School      @relation(fields: [School_id], references: [id])
  approvedBy    users?      @relation("ApprovedLeaves", fields: [approvedById], references: [id])
  student       students    @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([approvedById])
  @@index([School_id])
}

model Escalation {
  id                 String           @id @default(cuid())
  schoolId           String
  title              String
  description        String?
  severity           LogSeverity      @default(INFO)
  status             EscalationStatus @default(UNACKNOWLEDGED)
  reportedAt         DateTime         @default(now())
  acknowledgedAt     DateTime?
  acknowledgedBy     String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  acknowledgedByUser users?           @relation("AcknowledgedEscalations", fields: [acknowledgedBy], references: [id])
  school             School           @relation(fields: [schoolId], references: [id])
}

model BugReport {
  id            String          @id @default(cuid())
  userEmail     String?
  userRole      String?
  url           String?
  description   String?
  screenshotUrl String?
  status        String          @default("OPEN")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime?       @updatedAt
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum SubscriptionStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum ExamType {
  INTERNAL
  EXTERNAL
  BOARD
  COMPETITIVE
}

enum EventType {
  HOLIDAY
  EVENT
  EXAM_PREP
  ADMIN_ONLY
}

enum EscalationStatus {
  UNACKNOWLEDGED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
}

enum LogSeverity {
  INFO
  WARN
  CRITICAL
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGEMENT
  PRINCIPAL
  TEACHER
  STUDENT
  STAFF
  PARENT
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  GRADUATED
  WITHDRAWN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HOLIDAY
}


