# ─── Build artifacts ─────────────────────────────────────────────────────────
node_modules
dist
.prisma

# ─── Git & CI ────────────────────────────────────────────────────────────────
.git
.github

# ─── Environment files (secrets must never be in the image) ──────────────────
.env
.env.*
*.env

# ─── Firebase Service Account JSON (never bake credentials into an image) ────
*.json
!package.json
!package-lock.json
!nest-cli.json

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Local dev & scratch ─────────────────────────────────────────────────────
scratch
docs
*.dmm
*.tsbuildinfo

# ─── Test files (not needed in any image) ────────────────────────────────────
test
coverage
.nyc_output
